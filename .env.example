# CrowdTrust Environment Configuration Example
# Copy this file to server/.env and adjust values for your environment.

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# Replace with your MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/crowdtrust)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/crowdtrust?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_crowdtrust_jwt_key_replace_in_production_123456789
JWT_EXPIRES_IN=7d

# Payment Provider Simulation (Test / Sandbox Mode)
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_KEY=ct_test_pk_9948271038571937
PAYMENT_PROVIDER_SECRET=ct_test_sk_9948271038571937_secret

# Cloudinary / File Storage (Optional - fallback saves to local static uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini AI API Key (Optional - smart heuristic fallback engine included if not set)
GEMINI_API_KEY=
AI_API_KEY=
