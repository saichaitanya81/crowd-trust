# Dependencies
node_modules/
**/node_modules/

# Environment Variables & Secrets (CRITICAL: Never commit active .env)
.env
.env.local
.env.*.local
server/.env
client/.env

# Allow template example configs
!.env.example
!server/.env.example
!client/.env.example

# Build Outputs
dist/
dist-ssr/
client/dist/
build/

# Uploads
server/uploads/*
!server/uploads/.gitkeep

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
